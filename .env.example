# Rempli automatiquement par Vercel quand tu crées une base "KV" (Storage > KV)
# et que tu la connectes a ce projet. Pour tester en local, copie les valeurs
# depuis Vercel (Project > Storage > ta KV > .env.local tab) dans un fichier .env.local
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Mot de passe pour acceder a la page /admin (choisis-en un toi-meme)
ADMIN_PASSWORD=change-moi
