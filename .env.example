# ===================================================
# OPTION 1 : Google Sheets API (Compte de Service Google Cloud) - Recommandé
# ===================================================
# 1. ID de votre feuille Google Sheets (visible dans l'URL : https://docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=

# 2. Email du compte de service (ex: mon-service@mon-projet.iam.gserviceaccount.com)
GOOGLE_CLIENT_EMAIL=

# 3. Clé privée du compte de service (avec les \n)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# OU collez directement tout le contenu du fichier JSON téléchargé :
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ===================================================
# OPTION 2 : Google Apps Script Webhook (Ultra simple, sans Google Cloud)
# ===================================================
# Déployez le script fourni dans README.md comme application Web et collez l'URL ici :
GOOGLE_SHEET_WEBHOOK_URL=

# ===================================================
# Mot de passe administrateur (/admin)
# ===================================================
ADMIN_PASSWORD=change-moi
